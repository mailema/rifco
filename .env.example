# Copy this file to .env and fill in real values. NEVER commit the real .env file.

# Flask secret key - used to sign sessions and CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL connection string (Neon or any Postgres provider).
# Example: postgresql://user:password@host/dbname?sslmode=require
# If left empty, the app falls back to a local SQLite file for development only.
DATABASE_URL=

# Set to "production" when deploying. Controls debug mode and secure cookies.
FLASK_ENV=development
